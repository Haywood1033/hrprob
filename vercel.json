{
  "outputDirectory": ".",
  "functions": {
    "api/slate.js":    { "maxDuration": 30 },
    "api/statcast.js": { "maxDuration": 60 },
    "api/streaks.js":  { "maxDuration": 90 },
    "api/splits.js":   { "maxDuration": 90 },
    "api/history.js":  { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
